# Production overrides (merged over src/.env when building in production mode).
# VITE_WORKBOOKS_BASE is the Django mount prefix so CSnap project XMLs resolve under /workbooks/.
VITE_WORKBOOKS_BASE=/workbooks
# Origin-absolute paths where Django serves the CSnap IDE and the Joe's Lunch build.
# Change VITE_CSNAP_BASE_URL if Django serves CSnap somewhere other than /csnap-pro.
VITE_CSNAP_BASE_URL=/csnap-pro
VITE_JOESLUNCH_BASE_URL=/workbooks/joes-lunch
