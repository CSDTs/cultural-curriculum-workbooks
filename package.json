{
	"name": "workbook",
	"private": true,
	"version": "0.0.0",
	"packageManager": "pnpm@11.6.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build --base=/workbooks/",
		"deploy-build": "tsc --noEmit && vite build && sh adjust.sh",
